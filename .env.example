# Copy to .env and adjust as needed. All values are optional.

# ----- Hard safety caps (outer safety envelope) -----
# Absolute ceilings for a single local run. Raise with care.
LT_MAX_USERS_HARD_CAP=50000
LT_MAX_DURATION_HARD_CAP_S=1800

# Advisory threshold: above this, a single machine is usually the bottleneck
# and the UI recommends the distributed Locust cluster. Not a hard limit.
LT_SINGLE_MACHINE_RECOMMENDED_MAX=2000

# Hard ceiling on concurrent HTTP connections, so very large virtual-user
# counts cannot exhaust file descriptors / sockets and crash the engine.
LT_MAX_CONNECTION_POOL=10000

# ----- User-facing defaults -----
LT_DEFAULT_MAX_USERS=500
LT_DEFAULT_DURATION_S=60
LT_DEFAULT_SPAWN_RATE=10
LT_DEFAULT_TIMEOUT_S=10
LT_DEFAULT_ERROR_THRESHOLD_PCT=5
LT_DEFAULT_P95_THRESHOLD_MS=3000

# ----- Behaviour -----
# Allow localhost/private/internal targets by default (development only).
LT_ALLOW_PRIVATE_TARGETS=false

# ----- Storage -----
# Path to the local SQLite history database.
LT_DATABASE_PATH=data/history.db

# ----- Identity -----
LT_USER_AGENT=authorized-load-tester/1.0 (+local)
